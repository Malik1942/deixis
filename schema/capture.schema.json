{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malikzhang/deixis/schema/capture.schema.json",
  "title": "Deixis capture",
  "description": "One capture: the element the user pointed at, the cropped image on disk, and the context it came from. This file is the only interface between the Deixis app and anything else. The Markdown on the clipboard is derived from it, never the other way around. Field names are platform-neutral.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "mode",
    "image",
    "source",
    "element",
    "note",
    "resolved"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9]{4}$",
      "description": "Local timestamp yyyyMMdd-HHmmss plus 4 random base36 characters, so two captures in one second never collide. Same id as in the PNG and JSON file names. \"Latest\" is the newest createdAt, ties broken by id."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with the local UTC offset."
    },
    "mode": {
      "type": "string",
      "enum": [
        "fix",
        "reference"
      ],
      "description": "fix: the user's own code is on screen (front app is Simulator, bundle id is in MyApps, or URL host is localhost/127.0.0.1). reference: anything else."
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/element"
        },
        {
          "type": "null"
        }
      ],
      "description": "null when resolution failed. Never fabricated."
    },
    "note": {
      "type": "string",
      "description": "The user's note. Empty string when the note was skipped."
    },
    "resolved": {
      "type": "boolean",
      "description": "Always false when written by the app. Reserved for an agent or the MCP server to mark the capture as acted on."
    },
    "ocr": {
      "type": [
        "string",
        "null"
      ],
      "description": "Recognized text (v0.3 Text action). Always null when written by the v0.1 app."
    },
    "iterations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/iteration"
      },
      "description": "Verify records (v0.4), newest last. Always empty when written by the v0.1 app."
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "widthPt",
        "heightPt",
        "scale"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path to the cropped PNG."
        },
        "widthPt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Crop width in screen points."
        },
        "heightPt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Crop height in screen points."
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Backing scale factor of the source display (2 on Retina). Pixel size is points times scale."
        },
        "crop": {
          "$ref": "#/$defs/frame",
          "description": "The crop rectangle in global screen points, so element.frame can be placed inside the image."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "window",
        "url",
        "simulator"
      ],
      "properties": {
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundleId",
            "name"
          ],
          "properties": {
            "bundleId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "description": "The frontmost app at hotkey time."
        },
        "window": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The front window at hotkey time. null when there is none."
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Front tab URL. Filled only for Safari and Chrome; null otherwise."
        },
        "simulator": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "device",
                "appBundleId"
              ],
              "properties": {
                "device": {
                  "type": "string"
                },
                "appBundleId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when the front app is the iOS Simulator."
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "rawRole",
        "label",
        "identifier",
        "identifierSource",
        "value",
        "frame",
        "path"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "rawRole": {
          "type": "string",
          "description": "The platform's own role string (for example AXButton). Always present."
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable name: title or description."
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ],
          "description": "Developer-facing identifier as exposed by the platform, unmodified."
        },
        "identifierSource": {
          "type": "string",
          "enum": [
            "declared",
            "possiblySymbolName",
            "unknown"
          ],
          "description": "possiblySymbolName: role is image and the identifier matches ^[a-z0-9]+(\\.[a-z0-9]+)*$ (SF Symbol naming), so it may not be a declared identifier. declared: any other non-empty identifier. unknown: identifier is empty."
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathEntry"
          },
          "maxItems": 7,
          "description": "Ancestry, root-first: at most the nearest 6 ancestors, ending with the element itself."
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "description": "Present only when role is cluster: the accessibility elements the computed grouping contains, in reading order."
        }
      }
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$",
      "description": "Lowercase, platform-neutral role: button, textField, staticText, image, group, toolbar, navigationBar, unknown, and so on. Never AX-prefixed. `cluster` is a visual grouping computed by Deixis from neighbouring elements when the platform exposes no container (rawRole DeixisCluster); it is not an accessibility element and carries `members`."
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        }
      },
      "description": "Global screen points, top-left origin (accessibility convention)."
    },
    "pathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identifier"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "imagePath",
        "gitBefore",
        "gitAfter",
        "diffStat",
        "files"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "imagePath": {
          "type": "string",
          "description": "Absolute path to the after-image PNG."
        },
        "gitBefore": {
          "type": [
            "string",
            "null"
          ],
          "description": "Commit SHA before the change, when the app maps to a repository."
        },
        "gitAfter": {
          "type": [
            "string",
            "null"
          ]
        },
        "diffStat": {
          "type": [
            "string",
            "null"
          ],
          "description": "Output of git diff --stat between the two SHAs."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repository-relative paths touched."
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "label",
        "identifier"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
